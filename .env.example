# ===== DeepSeek API（必填）=====
DEEPSEEK_API_KEY=sk-xxxx
# 可不复制密钥；指定项目外的本地密钥文件即可。留空时会检查项目同级 deepseek_API.txt。
DEEPSEEK_API_FILE=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ===== SMTP 发信（H1 申请后填入）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的发信邮箱@qq.com
# 注意：这是邮箱设置的“授权码”，不是登录密码
SMTP_PASS=你的16位授权码
# 收件邮箱，先填自己邮箱测试，随时可改
RECIPIENT=收件邮箱@example.com
# 是否要求邮件带签名等，暂留空
MAIL_SUBJECT_PREFIX=【AI安全治理摘报】

# ===== 主备代理/VPN本地端口（采集用，格式二选一）=====
# 例：http://127.0.0.1:10809  或  socks5://127.0.0.1:10808
# PROXY 是旧配置名；未填 PROXY_PRIMARY 时仍会把 PROXY 当主线路。
PROXY=
PROXY_PRIMARY=
PROXY_BACKUP=
INGEST_CONNECTIVITY_CHECK=true
INGEST_CONNECTIVITY_TEST_URL=https://www.google.com/generate_204
INGEST_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
INGEST_TIMEOUT=25
INGEST_RETRIES=2
INGEST_REQUEST_INTERVAL=0.3
INGEST_MAX_RESPONSE_BYTES=4194304
INGEST_RESPECT_ROBOTS=true
INGEST_ROBOTS_FAIL_CLOSED=false

# ===== 出报与存储 =====
# 06:00截止统计，07:00生成并发送
REPORT_CUTOFF_HOUR=6
DELIVERY_HOUR=7
REPORT_TZ=Asia/Shanghai
# 仅文件名，自动存到 data/ 下
DB_PATH=app.db
LOG_DIR=logs
