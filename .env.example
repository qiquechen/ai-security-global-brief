# ===== DeepSeek API（必填）=====
DEEPSEEK_API_KEY=sk-xxxx
# 可不复制密钥；指定项目外的本地密钥文件即可。留空时会检查项目同级 deepseek_API.txt。
DEEPSEEK_API_FILE=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
# 通用客户端默认思考模式；筛选和摘要使用下面各自的配置
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_FILTER_THINKING_MODE=disabled
# 被明确剔除的 URL 保留天数；采集和筛选启动时清理到期记录
REJECTION_RETENTION_DAYS=7
DEEPSEEK_SUMMARY_THINKING_MODE=disabled

# ===== SMTP 发信（H1 申请后填入）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的发信邮箱@qq.com
# 注意：这是邮箱设置的“授权码”，不是登录密码
SMTP_PASS=你的16位授权码
# 收件邮箱，先填自己邮箱测试，随时可改
RECIPIENT=收件邮箱@example.com
# 是否要求邮件带签名等，暂留空
MAIL_SUBJECT_PREFIX=【AI安全治理摘报】
# true：原文始终打包为ZIP；false：原文逐个发送（仍受下面的强制阈值限制）
MAIL_ORIGINALS_ZIP=false
# 两类原文总数严格超过此值时强制打包；非负整数，0表示有原文就打包；不计合集
MAIL_ORIGINALS_ZIP_THRESHOLD=10

# ===== 主备代理/VPN本地端口（采集用，格式二选一）=====
# 例：http://127.0.0.1:10809  或  socks5://127.0.0.1:10808
# PROXY 是旧配置名；未填 PROXY_PRIMARY 时仍会把 PROXY 当主线路。
PROXY=
PROXY_PRIMARY=
PROXY_BACKUP=
INGEST_CONNECTIVITY_CHECK=true
INGEST_CONNECTIVITY_TEST_URL=https://www.google.com/generate_204
INGEST_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
INGEST_TIMEOUT=25
INGEST_RETRIES=2
# 不同来源并行抓取数；同一域名仍遵守下面的请求间隔
INGEST_WORKERS=6
INGEST_REQUEST_INTERVAL=0.3
INGEST_MAX_RESPONSE_BYTES=4194304
INGEST_RESPECT_ROBOTS=true
INGEST_ROBOTS_FAIL_CLOSED=false
INGEST_LNC_ENABLED=true
INGEST_LNC_START_TIMEOUT=45
INGEST_LNC_PAGE_TIMEOUT_MS=35000
INGEST_LNC_RENDER_DELAY=0.5
INGEST_LNC_PRUNING_THRESHOLD=0.48
INGEST_LNC_SCAN_FULL_PAGE=false

# ===== 出报与存储 =====
# 06:00截止统计，06:05准备，07:00只发送
REPORT_CUTOFF_HOUR=6
DELIVERY_HOUR=7
REPORT_TZ=Asia/Shanghai
# 仅文件名，自动存到 data/ 下
DB_PATH=app.db
LOG_DIR=logs

# 媒体和机构分别保底；不足时逐日回溯，先读库再抓取缺少类别
REPORT_MIN_PER_GROUP=5
REPORT_MAX_EXPANSION_DAYS=30
# 同重要度下机构来源评分提高20%，不直接改变语义重要度
REPORT_INSTITUTION_WEIGHT=1.2

# 完整响应写入本地结构化日志；仅包含最终正文，不记录思考过程。
LLM_LOG_RESPONSE=true

# ===== 失败告警与备份 =====
# 整理/发送失败时的告警收件人（逗号分隔）；留空则回退到 RECIPIENT
ALERT_RECIPIENT=
# 数据库备份保留份数（data/backup/）
BACKUP_KEEP=14
